    "title", "separator",
    { "type": "os", "key": " OS", "keyColor": "38;2;249;38;114" },
    { "type": "host", "key": "󰌢 Host", "keyColor": "38;2;253;151;31" },
    { "type": "kernel", "key": " Kernel", "keyColor": "38;2;230;219;116" },
    { "type": "uptime", "key": "󰅐 Uptime", "keyColor": "38;2;166;226;46" },
    { "type": "shell", "key": " Shell", "keyColor": "38;2;102;217;239" },
    { "type": "terminal", "key": " Term", "keyColor": "38;2;174;129;255" },
    { "type": "cpu", "key": " CPU", "keyColor": "38;2;249;38;114" },
    { "type": "gpu", "key": "󰢮 GPU", "keyColor": "38;2;253;151;31" },
    { "type": "memory", "key": " RAM", "keyColor": "38;2;230;219;116" },
    { "type": "disk", "key": "󰋊 Disk", "keyColor": "38;2;166;226;46", "folders": "/" },
    { "type": "battery", "key": "󰁹 Power", "keyColor": "38;2;102;217;239" },
    "break",
    "colors"
  ]
