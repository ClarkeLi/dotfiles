  "logo": { "type": "builtin", "source": "macos", "padding": { "top": 1, "left": 2, "right": 3 },
    "color": { "1": "38;2;249;38;114", "2": "38;2;253;151;31", "3": "38;2;230;219;116", "4": "38;2;166;226;46", "5": "38;2;102;217;239", "6": "38;2;174;129;255" } },
